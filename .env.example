# NextShift Configuration

# App
PROJECT_NAME="NextShift"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database
# Default to MySQL as per specification
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/nextshift?charset=utf8mb4"

# Security / JWT
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Seeding (via CLI: uv run python -m app.cli seed-admin)
FIRST_ADMIN_NAME="System Administrator"
FIRST_ADMIN_EMAIL="admin@nextshift.local"
FIRST_ADMIN_PASSWORD="AdminSecurePassword123!"
